# Obsolete pre-IndexedDB saves may still exist locally; never commit them.
saves/
stories/
openings/
reading-openings/
story-images/
story-audio/
word-audio/
learner/
translation-cache.json

# Editor directories and files
# Agent skills and shared settings are tracked; machine-local settings are not.
# `.claude/skills/*` are symlinks into `.codex/skills/`, so the skill text lives once.
.codex/*
!.codex/skills/
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript build info
*.tsbuildinfo

# Playwright MCP session snapshots
.playwright-mcp/
# Safety net: a relative `filename` passed to browser_take_screenshot resolves
# against $CWD (the repo root), not the configured --output-dir. Root-anchored
# so real image assets under public/ or src/ are unaffected.
/*.png
/*.jpeg
/*.jpg
rosti/.rostistate

# Local AI/tool artifacts and scratch outputs
.artifacts/
server.mjs
