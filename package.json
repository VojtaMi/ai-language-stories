{
	"name": "language-story-reader",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"ai-log:pretty": "tsx scripts/format-ai-call-log.ts pretty",
		"ai-log:summary": "tsx scripts/format-ai-call-log.ts summary",
		"build": "tsc -b && vite build && npm run build:server",
		"build:server": "vite build --config vite.server.config.ts && node -e \"require('node:fs').copyFileSync('dist-server/production.js','server.mjs')\"",
		"check": "npm run build && npm run lint && npm run language:validate && npm run languages:test && npm run reading:test && npm run story-cli:test && npm run model-selection:test && npm run reading:preparation:test && npm run finish-evidence:test && npm run story-recap:test && npm run rate-limit:test",
		"dev": "concurrently \"npm:dev:api\" \"npm:dev:vite\"",
		"dev:api": "PORT=3001 tsx watch --env-file-if-exists=.env.local src/server/production.ts",
		"dev:vite": "vite",
		"gemini:images": "tsx --env-file-if-exists=.env.local scripts/compare-gemini-images.ts",
		"gemini:tts": "tsx --env-file-if-exists=.env.local scripts/test-gemini-tts.ts",
		"gemini:tts:compare": "tsx --env-file-if-exists=.env.local scripts/compare-gemini-tts.ts",
		"images:optimize": "tsx scripts/optimize-language-images.ts",
		"lint": "biome ci .",
		"lint:fix": "biome check --write .",
		"lint:staged": "biome check --staged --no-errors-on-unmatched",
		"languages:test": "tsx tests/languages.test.ts",
		"language:validate": "tsx scripts/validate-languages.ts",
		"model-selection:test": "tsx tests/model-selection.test.ts",
		"prepare": "husky",
		"preview": "vite preview",
		"start": "NODE_ENV=production PORT=8080 node --env-file-if-exists=.env server.mjs",
		"reading:test": "tsx tests/reading-story.test.ts",
		"reading:preparation:test": "node --import ./scripts/register-css-loader.mjs --import tsx tests/reading-preparation.test.ts",
		"rate-limit:test": "tsx tests/rate-limit.test.ts",
		"finish-evidence:test": "tsx tests/story-finish-evidence.test.ts",
		"story-cli:test": "tsx tests/story-cli.test.ts",
		"story-recap:test": "tsx tests/story-recap.test.ts",
		"story:generate": "tsx --env-file-if-exists=.env.local scripts/generate-reading-story.ts",
		"story:chain": "tsx --env-file-if-exists=.env.local scripts/simulate-reading-story-chain.ts",
		"verify:page": "node scripts/verify-page.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.104.2",
		"@tanstack/react-router": "^1.170.31",
		"openai": "^6.42.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/node": "^25.9.3",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^6.0.3",
		"concurrently": "^10.0.3",
		"husky": "^9.1.7",
		"playwright": "1.61.1",
		"tsx": "^4.19.4",
		"typescript": "^5.6.3",
		"vite": "^8.1.0"
	}
}
